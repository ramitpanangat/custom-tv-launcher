<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for this TV. The tile layout itself is edited on the TV (hold OK on a tile) and saved there. -->
<resources>
    <string name="app_name" translatable="false">Tiles</string>

    <!-- What the Inputs button opens: a component first (Geepas/Cultraview source menu), then the standard
         Android TV input picker if that component is missing. -->
    <string name="inputs_component" translatable="false">com.cultraview.setting/.SourceActivity</string>

    <!-- Tiles on a first start, in this order, as "key:size". size is small, medium, wide or large;
         "clock" is the clock tile. Apps not listed follow as medium tiles, sorted by name. -->
    <string-array name="default_layout" translatable="false">
        <item>clock:wide</item>
        <item>com.google.android.youtube.tv:medium</item>
        <item>com.netflix.mediaclient:medium</item>
        <item>com.amazon.amazonvideo.livingroom:medium</item>
        <item>com.android.vending:medium</item>
    </string-array>

    <!-- Never shown as tiles: launchers. -->
    <string-array name="excluded_packages" translatable="false">
        <item>com.gathin.tvhome</item>
        <item>com.zeasn.launcher</item>
    </string-array>

    <!-- The tile palette: Windows Phone's Metro colours, all at a similar intensity so no tile shouts. An app with
         no colour of its own below gets the palette colour nearest to its artwork, so new apps fit in. Empty: the
         sampled colour as it is. -->
    <string-array name="tile_palette" translatable="false">
        <item>#E51400</item>   <!-- red -->
        <item>#A20025</item>   <!-- crimson -->
        <item>#D80073</item>   <!-- magenta -->
        <item>#AA00FF</item>   <!-- violet -->
        <item>#6A00FF</item>   <!-- indigo -->
        <item>#0050EF</item>   <!-- cobalt -->
        <item>#1BA1E2</item>   <!-- cyan -->
        <item>#00ABA9</item>   <!-- teal -->
        <item>#008A00</item>   <!-- emerald -->
        <item>#60A917</item>   <!-- green -->
        <item>#F0A30A</item>   <!-- amber -->
        <item>#FA6800</item>   <!-- orange -->
        <item>#825A2C</item>   <!-- brown -->
        <item>#647687</item>   <!-- steel -->
        <item>#76608A</item>   <!-- mauve -->
    </string-array>

    <!-- A tile colour instead of the palette's nearest, "package=#RRGGBB". Neighbours get clearly different hues. -->
    <string-array name="tile_colors" translatable="false">
        <item>com.google.android.youtube.tv=#FF0000</item>        <!-- YouTube's own red, with the white logo -->
        <item>com.netflix.mediaclient=#101010</item>              <!-- near-black, like Netflix's icon (red N below) -->
        <item>com.amazon.amazonvideo.livingroom=#0050EF</item>    <!-- cobalt -->
        <item>com.android.vending=#008A00</item>                  <!-- emerald -->
        <item>com.android.settings=#647687</item>                 <!-- steel -->
        <item>com.ecloud.eshare.server=#FA6800</item>             <!-- orange -->
        <item>com.cultraview.filemanager=#F0A30A</item>           <!-- amber -->
        <item>com.cultraview.setting=#6A00FF</item>               <!-- indigo -->
    </string-array>

    <!-- A glyph drawn in a colour instead of white, "package=#RRGGBB": a brand mark on a dark tile. -->
    <string-array name="tile_glyph_colors" translatable="false">
        <item>com.netflix.mediaclient=#E50914</item>   <!-- Netflix red -->
    </string-array>

    <!-- Apps whose own icon is shown as a white silhouette (its light parts kept, its background dropped), for an
         official logo that should still match the white glyphs. -->
    <string-array name="tile_icons_white" translatable="false">
        <item>com.amazon.amazonvideo.livingroom</item>
    </string-array>
    <!-- A name after the greeting at the top left: "Sam" shows "Good evening, Sam". Empty: the greeting alone. -->
    <string name="greeting_name" translatable="false"></string>
    <!-- The background behind the tiles: a gradient from the top left to the bottom right, painted once as the
         window background (no image, no extra drawing per frame). -->
    <string-array name="background_colors" translatable="false">
        <item>#000000</item>
        <item>#03060F</item>
        <item>#0A1530</item>
    </string-array>
    <!-- Number keys 1-9 open the app tiles in their order on screen (0 the tenth), skipping the clock. -->
    <bool name="number_shortcuts">true</bool>
    <!-- Minutes Home may sit untouched before the full-screen clock appears by itself; 0 turns it off. Only ever
         on Home: never over an app or a video. -->
    <integer name="idle_clock_minutes">10</integer>
    <!-- The selected tile dips slightly while OK is held, like a Windows Phone tile. -->
    <bool name="press_tilt">true</bool>
    <!-- When Home comes back from an app, the tiles turn into place one after another (about 0.4 s). -->
    <bool name="tile_entrance">true</bool>
    <!-- Seconds between clock tile flips (time on the front, day and date on the back). 0 keeps it still. -->
    <integer name="clock_flip_seconds">15</integer>
    <!-- The clock tile's background through the day, as "#from,#to" (or "#from,#middle,#to") gradients (top left to bottom right) in this
         order: morning (5-12), afternoon (12-17), evening (17-22), night (22-5), the same hours as the greeting.
         Each is drawn once into a tiny bitmap that the GPU stretches; the tile changes about four times a day.
         Leave the array empty for the plain clock_color. -->
    <string-array name="clock_gradients" translatable="false">
        <item>#F09A51,#D9768F,#5B8BD9</item>   <!-- morning: sunrise orange, through rose, to sky blue -->
        <item>#1BA1E2,#0050EF</item>   <!-- afternoon: bright cyan to blue -->
        <item>#E2535C,#6A3FA0</item>   <!-- evening: sunset coral to purple -->
        <item>#2B1E6E,#0A0F2C</item>   <!-- night: deep indigo to near-black navy -->
    </string-array>
    <!-- The clock tile's colour. -->
    <string name="clock_color" translatable="false">#1BA1E2</string>
    <!-- A white glyph (res/drawable/ic_tile_*) instead of the app's own icon, "package=drawable". Apps not
         listed, such as ones installed later, keep their own icon. -->
    <string-array name="tile_icons" translatable="false">
        <item>com.google.android.youtube.tv=ic_tile_youtube</item>
        <item>com.netflix.mediaclient=ic_tile_netflix</item>
        <item>com.android.vending=ic_tile_store</item>
        <item>com.android.settings=ic_tile_settings</item>
        <item>com.ecloud.eshare.server=ic_tile_eshare</item>
        <item>com.cultraview.filemanager=ic_tile_folder</item>
        <item>com.cultraview.setting=ic_tile_tv_settings</item>
    </string-array>
    <!-- A tile name instead of the app's own, "package=Name". -->
    <string-array name="tile_labels" translatable="false">
        <item>com.android.settings=Android Settings</item>
        <item>com.ecloud.eshare.server=EShare</item>
        <item>com.cultraview.setting=TV Settings</item>
    </string-array>
</resources>
